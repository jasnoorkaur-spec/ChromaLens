# MySQL connection string; set locally and never commit actual credentials.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Optional Gemini Vision enrichment. Keep the real value in the backend runtime environment.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Exact frontend origin for credentialed CORS, e.g. https://your-frontend.example
FRONTEND_ORIGIN="http://localhost:5173"

# Optional; images are uploaded only for an authenticated saveHistory=true request.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
